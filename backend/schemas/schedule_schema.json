  "required": ["id", "service_provider", "category", "amount", "scheduled_at"],
  "properties": {
    "id": {"type": "string"},
    "service_provider": {"type": "string"},
    "category": {"type": "string"},
    "amount": {"type": "number"},
    "scheduled_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string"}
  },
  "additionalProperties": true
}
