# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=PaySmart

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/paysmart?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=12345abcd
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=12345abcedt
JWT_REFRESH_EXPIRES_IN=30d

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── eSewa ───────────────────────────────────────────────────────────────────
ESEWA_MERCHANT_ID=your_esewa_merchant_id
ESEWA_SECRET_KEY=your_esewa_secret_key
ESEWA_BASE_URL=https://uat.esewa.com.np
ESEWA_SUCCESS_URL=http://localhost:3000/payments/esewa/success
ESEWA_FAILURE_URL=http://localhost:3000/payments/esewa/failure

# ─── Khalti ──────────────────────────────────────────────────────────────────
KHALTI_SECRET_KEY=your_khalti_secret_key
KHALTI_PUBLIC_KEY=your_khalti_public_key
KHALTI_BASE_URL=https://a.khalti.com/api/v2

# ─── Firebase FCM ────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ─── Webhook ─────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=your_webhook_signing_secret

# ─── Rate Limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Sparrow SMS (Nepal) ──────────────────────────────────────────────────────
SPARROW_SMS_TOKEN=your_sparrow_sms_token
SPARROW_SMS_FROM=PaySmart
SPARROW_SMS_BASE_URL=https://api.sparrowsms.com/v2/sms
SMS_TEST_MODE=true

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6

# ─── Security Keys (generate with: node -e "require('crypto').randomBytes(32).toString('hex')") ─
HMAC_SECRET=your_hmac_secret_here
ENCRYPTION_KEY=your_32_byte_hex_key_here
