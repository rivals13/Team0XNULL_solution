// ─── PaySmart Database Schema ─────────────────────────────────────────────────
// eSewa Hackathon Challenge 11

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["paysmart", "esewa_sync"]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  MERCHANT
  ADMIN

  @@schema("paysmart")
}

enum TransactionType {
  DEBIT
  CREDIT

  @@schema("paysmart")
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED

  @@schema("paysmart")
}

enum ScheduleFreq {
  ONCE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM_CRON

  @@schema("paysmart")
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED

  @@schema("paysmart")
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  DISPUTED

  @@schema("paysmart")
}

enum SuggestionType {
  BILL_REMINDER
  PAYMENT_SUGGESTION
  SCHEDULE_RECOMMENDATION
  SPENDING_INSIGHT
  SAVINGS_TIP

  @@schema("paysmart")
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
  EXPIRED

  @@schema("paysmart")
}

enum NotificationType {
  BILL_DUE
  BILL_PAID
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SCHEDULE_REMINDER
  SCHEDULE_TRIGGERED
  NEW_SUGGESTION
  SYSTEM

  @@schema("paysmart")
}

enum MerchantCategory {
  UTILITY
  ELECTRICITY
  WATER
  TELECOM
  INTERNET
  INSURANCE
  GOVERNMENT
  EDUCATION
  HEALTHCARE
  ENTERTAINMENT
  FINANCE
  RETAIL
  TV
  TRAFFIC
  OTHER

  @@schema("paysmart")
}

enum TokenType {
  ESEWA_SESSION
  KHALTI_SESSION
  PAYMENT_AUTH

  @@schema("paysmart")
}

// ─── User ─────────────────────────────────────────────────────────────────────
model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  phone      String?  @unique
  password   String
  avatarUrl  String?
  fcmToken   String?
  role       UserRole @default(USER)
  isActive   Boolean  @default(true)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions    Transaction[]
  schedules       Schedule[]
  notifications   Notification[]
  bills           Bill[]
  billerAccounts  BillerAccount[]
  suggestions     Suggestion[]
  merchantProfile Merchant?
  paymentTokens   PaymentToken[]
  dataAccessLogs  DataAccessLog[]

  @@index([phone])
  @@map("users")
  @@schema("paysmart")
}

// ─── Merchant ─────────────────────────────────────────────────────────────────
model Merchant {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  category    MerchantCategory
  logoUrl     String?
  description String?
  website     String?
  isActive    Boolean          @default(true)
  // Self-registered merchant (MERCHANT-role user) fields
  userId            String?          @unique   // links to User.id
  apiKey            String           @unique   @default(cuid())
  billInquiryUrl    String?          @map("bill_inquiry_url")
  billInquiryApiKey String?          @map("bill_inquiry_api_key")  // AES-256-GCM encrypted
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  /// Stores eSewa ID, Khalti ID and bank accounts as JSON:
  /// { esewa?: string, khalti?: string, banks?: [{bankName,accountNumber,accountHolder,branchCode?}] }
  paymentMethods Json?

  user           User?           @relation(fields: [userId], references: [id])
  billerAccounts BillerAccount[]
  bills          Bill[]
  transactions   Transaction[]

  @@index([category])
  @@map("merchants")
  @@schema("paysmart")
}

// ─── BillerAccount ────────────────────────────────────────────────────────────
model BillerAccount {
  id            String   @id @default(cuid())
  userId        String
  merchantId    String
  accountNumber String
  accountName   String?
  nickname      String?
  isDefault     Boolean  @default(false)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  bills        Bill[]
  schedules    Schedule[]
  transactions Transaction[]

  @@unique([userId, merchantId, accountNumber])
  @@index([userId])
  @@index([merchantId])
  @@map("biller_accounts")
  @@schema("paysmart")
}

// ─── Bill ─────────────────────────────────────────────────────────────────────
model Bill {
  id              String     @id @default(cuid())
  userId          String
  merchantId      String
  billerAccountId String?   // null for merchant-pushed bills
  amount          Float
  dueDate         DateTime
  billingPeriod   String?
  status          BillStatus @default(PENDING)
  description     String?
  paidAt          DateTime?
  transactionId   String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  billerAccount BillerAccount? @relation(fields: [billerAccountId], references: [id])
  transaction   Transaction?   @relation(fields: [transactionId], references: [id])
  schedules     Schedule[]
  suggestions   Suggestion[]

  @@index([userId])
  @@index([merchantId])
  @@index([billerAccountId])
  @@index([status])
  @@index([dueDate])
  @@map("bills")
  @@schema("paysmart")
}

// ─── Transaction ──────────────────────────────────────────────────────────────
model Transaction {
  id              String            @id @default(cuid())
  userId          String
  merchantId      String?
  billerAccountId String?
  scheduleId      String?
  amount          Float
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  provider        String?
  recipientId     String?
  externalId      String?           @unique
  description     String?
  failureReason   String?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant      Merchant?      @relation(fields: [merchantId], references: [id])
  billerAccount BillerAccount? @relation(fields: [billerAccountId], references: [id])
  schedule      Schedule?      @relation(fields: [scheduleId], references: [id])
  bill          Bill?

  @@index([userId])
  @@index([merchantId])
  @@index([billerAccountId])
  @@index([scheduleId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
  @@schema("paysmart")
}

// ─── Schedule ─────────────────────────────────────────────────────────────────
model Schedule {
  id              String         @id @default(cuid())
  userId          String
  billerAccountId String?
  billId          String?
  name            String
  amount          Float
  provider        String
  recipientId     String
  frequency       ScheduleFreq
  status          ScheduleStatus @default(ACTIVE)
  nextRunAt       DateTime
  lastRunAt       DateTime?
  endDate         DateTime?
  cronExpression  String?
  autoRetry       Boolean        @default(true)
  retryCount      Int            @default(0)
  maxRetries      Int            @default(3)
  maxOccurrences  Int            @default(0)   // 0 = unlimited; 1–10 = stop after N payments
  executedCount   Int            @default(0)   // incremented each time cron fires
  description     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  billerAccount BillerAccount? @relation(fields: [billerAccountId], references: [id])
  bill          Bill?          @relation(fields: [billId], references: [id])
  transactions  Transaction[]
  suggestions   Suggestion[]

  @@index([userId])
  @@index([billerAccountId])
  @@index([status, nextRunAt])
  @@map("schedules")
  @@schema("paysmart")
}

// ─── Suggestion ───────────────────────────────────────────────────────────────
model Suggestion {
  id         String           @id @default(cuid())
  userId     String
  scheduleId String?
  billId     String?
  type       SuggestionType
  status     SuggestionStatus @default(PENDING)
  title      String
  body       String
  metadata   Json?
  expiresAt  DateTime?
  actedAt    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id])
  bill     Bill?     @relation(fields: [billId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([type])
  @@map("suggestions")
  @@schema("paysmart")
}

// ─── Notification ─────────────────────────────────────────────────────────────
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
  @@schema("paysmart")
}

// ─── Webhook Event (inbound) ──────────────────────────────────────────────────
model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventType String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([provider, processed])
  @@map("webhook_events")
  @@schema("paysmart")
}

// ─── Registered App (multi-app webhook dispatch) ──────────────────────────────
model RegisteredApp {
  id            String   @id @default(cuid())
  name          String
  webhookUrl    String?
  webhookSecret String   @default(cuid())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("registered_apps")
  @@schema("paysmart")
}

// ─── PaymentToken ─────────────────────────────────────────────────────────────
// Stores short-lived session tokens for payment providers.
// NEVER store: passwords, MPINs, OTPs, full bank account numbers, CVVs.
model PaymentToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    // AES-256-GCM encrypted token value
  tokenType TokenType
  expiresAt DateTime
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, tokenType, isActive])
  @@map("payment_tokens")
  @@schema("paysmart")
}

// ─── DataAccessLog ────────────────────────────────────────────────────────────
// Audit trail for every access to user PII / eSewa data.
// IP stored with last octet masked: 192.168.1.0 (not .x)
model DataAccessLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // e.g. "READ_TRANSACTIONS", "EXPORT_DATA"
  dataType   String   // e.g. "phone", "email", "esewa_transactions"
  ipAddress  String?  // last octet masked, e.g. "192.168.1.0"
  success    Boolean  @default(true)
  metadata   Json?
  accessedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, accessedAt])
  @@index([action])
  @@map("data_access_logs")
  @@schema("paysmart")
}

// ═══════════════════════════════════════════════════════════════════════════════
// esewa_sync schema — eSewa integration data with consent gating
// ═══════════════════════════════════════════════════════════════════════════════

// ─── EsewaUserConsent ─────────────────────────────────────────────────────────
// User must grant consent before any eSewa data is fetched/stored.
// Consent expires after 90 days; user can revoke at any time.
model EsewaUserConsent {
  id           String    @id @default(cuid())
  userId       String    @unique
  dataTypes    String[]  // e.g. ["transactions","profile","bills"]
  grantedAt    DateTime  @default(now())
  expiresAt    DateTime  // grantedAt + 90 days
  revokedAt    DateTime?
  isActive     Boolean   @default(true)
  ipAddress    String?   // consent given from (last octet masked)
  userAgent    String?

  @@index([userId])
  @@index([userId, isActive])
  @@map("esewa_user_consent")
  @@schema("esewa_sync")
}

// ─── EsewaTransaction ─────────────────────────────────────────────────────────
// Synced transaction records from eSewa.
// Encrypted fields: esewaPhone, transactionRef, customerId
// NEVER stored: eSewa password, MPIN, OTP, full bank numbers, CVV
model EsewaTransaction {
  id             String   @id @default(cuid())
  userId         String
  esewaPhone     String?  // AES-256-GCM encrypted
  transactionRef String   // AES-256-GCM encrypted
  customerId     String?  // AES-256-GCM encrypted
  amount         Float
  payee          String?
  status         String
  transactionDate DateTime
  syncedAt       DateTime @default(now())
  rawMetadata    Json?    // sanitized — no passwords/pins/OTPs

  @@index([userId])
  @@index([userId, transactionDate])
  @@map("esewa_transactions")
  @@schema("esewa_sync")
}
